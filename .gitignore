# Don't commit binaries
*.a
*.asm
*.dll
*.dylib
*.exe
*.lib
*.out
*.o
*.so
*.so.*
# Clang cache
.cache/
# Exclude editor config
.vscode/
.vs/
# Exclude temporary folders
*.egg-info/
.eggs/
build/
build_cmake/
# Exclude macOS folder attributes
.DS_Store
# Exclude macOS Info.framework.plist
Info.framework.plist
# Python byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
# MuJoCo
MUJOCO_LOG.TXT
MJDATA.TXT
MJMODEL.TXT
# Python
python/dist/
# Overleaf draft (do not commit)
overleaf/
# Build artifacts
build_asan/
# Experiment outputs
out/
sweep_*/
auto_mlp_cost_run/
# Large training checkpoints (>100MB single-file limit on GitHub).
