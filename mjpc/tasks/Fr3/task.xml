<mujoco model="Fr3">
  <include file="../common.xml"/>

  <!-- nuserdata reserves slots in mjData->userdata for sharing between
       TransitionLocked (writes) and the cost functions (read).
       Layout: [0..2] = traj_final_mocap_ (xyz), [3] = hybrid_active flag,
       [4] = absolute time hybrid first activated (used by CostPressZ to lerp
             virtual_z from approach target down to press_z_target). -1 means
             hybrid not yet on. -->
  <size memory="1M" nuserdata="5"/>

  <custom>
    <numeric name="agent_planner" data="0" />

    <!-- ===== MJPC-style sampling (post-reference-parity) =====
         Reference-aligned config (T=40 zero-spline knots, dt=0.003,
         dc_noise=1, raw sigma {2,2,2,2,1,1,1}) is preserved on a separate
         git branch. Here we adopt MJPC's stock sampling scheme: longer
         horizon, fewer cubic knots, per-knot independent Gaussian, and
         ctrlrange-scaled sigma. Hyperparameters (lambda / exploration /
         cost weight scale) are tuned together below. -->
    <numeric name="agent_horizon" data="0.2" />
    <numeric name="agent_timestep" data="0.01" />

    <numeric name="agent_policy_width" data="0.0035" />
    <numeric name="sampling_trajectories" data="128"/>
    <!-- Stage-1 best (4D sweep, 5-seed verified): knots=2, Linear, lambda=1,
         exploration=0.05, jc=100. L1_settled_med = 0.051 rad (≈3°). -->
    <numeric name="sampling_spline_points" data="2" />
    <numeric name="sampling_representation" data="1" />
    <!-- Exploration scales the (ctrlrange/2)-based sigma. With ctrlrange
         ±87 N*m for FR3 actuators, exploration=0.05 -> sigma ≈ 4.35 N*m
         per joint. Tune. -->
    <numeric name="sampling_exploration" data="0.02" />
    <!-- MPPI temperature. Tune in concert with cost-weight magnitude. -->
    <numeric name="sampling_lambda" data="1.0" />
    <!-- Independent Gaussian per knot (stock MJPC). -->
    <numeric name="sampling_dc_noise" data="0" />
    <!-- Per-joint sigma override DISABLED (size!=nu means fallback to
         ctrlrange-based sigma in AddNoiseToPolicy). -->
    <numeric name="sampling_std_per_joint" size="1" data="0" />
    <numeric name="gradient_spline_points" data="6" />
    <!-- // =============== EC =============== // -->
    <!-- WIP CHUNK 3: force-control numerics -->
    <numeric name="F_des" size="3" data="0 0 -10"/>
    <numeric name="approach_time"    data="2.0"/>
    <!-- Stage-2 reach test: lock mocap to robot's home EE position (skip
         approach lerp). Robot should hold its initial EE pose against the
         q_mid pull from joint_cent. Set 0 to restore normal lerp. -->
    <numeric name="home_lock_mocap" data="1"/>
    <!-- Residual normalization: residual = drift / scale, so the same
         `weight` value applies equally to position and orientation cost.
         pos_scale = 10 cm; ori_scale = 5 deg = 0.0873 rad. -->
    <numeric name="reach_pos_scale" data="0.1"/>
    <numeric name="reach_ori_scale" data="0.0873"/>
    <!-- Moving target overlay (only active when home_lock_mocap=1).
         0=static, 1=circle xy, 2=step xy, 3=ramp x. -->
    <!-- Event-based step pattern. Robot dwells at each target until EE is
         within `target_advance_threshold` for `target_dwell_time` continuous
         seconds, then advances. Step 0 = home (initial reach). Steps 1..max
         = 4-corner square ±radius in xy around home. -->
    <numeric name="target_step_enable"        data="0"/>
    <numeric name="target_step_radius"        data="0.07"/>
    <numeric name="target_step_rot_deg"       data="15.0"/>
    <numeric name="target_advance_threshold"  data="0.005"/>
    <numeric name="target_advance_ori_thresh" data="0.0873"/>
    <numeric name="target_dwell_time"         data="0.5"/>
    <numeric name="target_max_steps"          data="4"/>
    <!-- Goal-reach criterion for switching from approach -> hybrid:
         EE site within `hybrid_switch_dist` (m) AND
         orientation axis-angle error < `hybrid_switch_angle` (rad).
         After both met, wait `hybrid_switch_delay` (s) before switching. -->
    <numeric name="hybrid_switch_dist"  data="0.02"/>
    <numeric name="hybrid_switch_angle" data="0.087"/>  <!-- ~5 deg -->
    <numeric name="hybrid_switch_delay" data="0.5"/>
    <!-- xy force regulation toggle: 0 = off (z-only), 1 = on (regulate F_x, F_y -> 0). -->
    <numeric name="force_xy_regulation" data="1"/>

    <!-- Force-track asymmetry. err = F_des - F_press_world_z.
         residual = err if err<0 (undershoot), r*err if err>0 (overshoot).
         Effective overshoot weight is r^2 * undershoot weight.
         r=0 pure asymmetric, r=1 pure symmetric, 0.3 mild pull toward F_des. -->
    <numeric name="force_overshoot_ratio" data="1.0"/>
    <!-- EE total weight (N) used to remove gravity bias from hand_force
         sensor. Default 7.46 = (0.73 hand + 2*0.015 finger) * 9.81.
         Override here if panda hand mass differs. -->
    <numeric name="ee_weight_N" data="7.46"/>
    <numeric name="force_track_cap" data="20.0"/>

    <!-- Manipulability barrier threshold. residual = max(0, manip_min - w(q))
         where w = sqrt(det(J*J^T)). Tune by reading observed w in steady
         press states; set manip_min just above the regime where lift bug
         occurs. -->
    <numeric name="manip_min" data="0.0"/>

    <!-- Impedance press parameters (paper-aligned).
         press_z_target: virtual setpoint below the table top (m). Steady
           penetration at table top (z=0.30) gives press force ≈
           2 * Press_z_weight * (0.30 - press_z_target). With weight 1000 and
           target 0.295 (5 mm below), implied force ≈ 10 N.
         press_lerp_time: smooth lerp from approach z target to press_z_target
           after hybrid activation, to avoid step-input contact spikes. -->
    <numeric name="press_z_target"  data="0.295"/>
    <numeric name="press_z_lift_thresh" data="0.315"/>
    <numeric name="press_lerp_time" data="0.5"/>

    <!-- Wiping/polishing motion. Sequence:
           1) approach completes
           2) hybrid mode activates (geometric reach + delay)
           3) F_press_world_z < contact_threshold -> contact confirmed
           4) wait wipe_delay seconds
           5) mocap (x,y) moves along circle of wipe_radius, period wipe_period
         z is untouched so contact depth is maintained. wipe_enable=0 for
         pure press (no wiping). contact_threshold is in N (negative = press). -->
    <numeric name="wipe_enable"        data="0"/>
    <!-- Contact criterion: BOTH must hold (AND).
         contact_z_thresh: EE site z below this (m). Table top z=0.3 so
           default 0.31 means "EE within 1cm of table top".
         contact_threshold: F_press_world_z below this (N, negative=press).
           Default -1.0 = pressing at least 1 N down. -->
    <numeric name="contact_z_thresh"   data="0.31"/>
    <numeric name="contact_threshold"  data="-1.0"/>
    <numeric name="wipe_delay"         data="1.0"/>
    <numeric name="wipe_radius"        data="0.05"/>
    <numeric name="wipe_period"        data="5.0"/>
    <!-- // ================================== // -->
  </custom>

  <statistic extent="1.5" center="0.1 0.2 0.3"/>

  <visual>
    <quality shadowsize="8192"/>
    <global azimuth="180" elevation="-30"/>
    <scale framelength=".3" framewidth=".03"/>
  </visual>

  <default>
    <geom solref=".001 1"/>
  </default>

  <asset>
    <material class="panda" name="white_trans" rgba="1 1 1 0.3"/>
    <material class="panda" name="off_white_trans" rgba="0.901961 0.921569 0.929412 0.3"/>
    <material class="panda" name="black_trans" rgba="0.25 0.25 0.25 0.3"/>
  </asset>

  <compiler texturedir="./textures"/>

  <worldbody>
    <site name="world"/>
    <light pos="0 -0.1 0.5" dir="0 0.2 -1" diffuse="0.7 0.7 0.7" specular="0.3 0.3 0.3"
        directional="true" castshadow="true"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane" material="blue_grid"/>

    <!-- Table. solref=0.004 1 (4× softer than default 0.001) follows
         MJPC manipulation/task_panda_bring object-side practice and tames
         the sub-step contact transients we observed in the stiff-default
         configuration. -->
    <body name="table" pos="0.55 0.1 0.1">
      <geom name="table_top" type="box" size="0.2 0.8 0.2"
            rgba="0.55 0.35 0.18 1" friction="0.5 0.005 0.0001"
            contype="1" conaffinity="1" solref="0.004 1"/>
    </body>

    <!-- <body name="target" mocap="true" pos="0.6 0.4 0.05">
      <geom name="target"  type="box" size="0.02 0.03 0.02" contype="0" conaffinity="0" rgba=".5 .5 .5 .3"/>
      <site name="target1" type="box" pos="0  .026 0" size="0.021 0.005 0.021" rgba="1 .1 .1 .3"/>
      <site name="target2" type="box" pos="0 -.026 0" size="0.021 0.005 0.021" rgba=".1 .1 1 .3"/>
    </body> -->


    <!-- <body name="box" pos="0.4 0.0 0.5" mocap="true">
      <freejoint/>
      <geom name="box"  type="box" size="0.02 0.03 0.02" priority="1" condim="6" friction="1 .01 .003"/>
      <geom name="box"  type="box" size="0.02 0.03 0.02" contype="0" conaffinity="0" rgba=".5 .5 .5 .3"/>
      <site name="box1" type="box" pos="0  .026 0" size="0.021 0.005 0.021" rgba="1 .1 .1 1"/>
      <site name="box2" type="box" pos="0 -.026 0" size="0.021 0.005 0.021" rgba=".1 .1 1 1"/>
    </body> -->

    <!--  hand_copy -->
    <!-- <body name="hand_copy" pos="0.5 0.3 0.5" quat="0.9238795 0 0 -0.3826834" mocap="true"> -->
    <body name="hand_copy" pos="0.5 0.3 0.5" quat="0 1 0 0" mocap="true">
      <inertial mass="0.73" pos="-0.01 0 0.03" diaginertia="0.001 0.0025 0.0017"/>
      <geom mesh="hand_0" material="off_white_trans" class="visual" contype="0" conaffinity="0"  />
      <geom mesh="hand_1" material="black_trans" class="visual" contype="0" conaffinity="0" />
      <geom mesh="hand_2" material="black_trans" class="visual" contype="0" conaffinity="0" />
      <geom mesh="hand_3" material="white_trans" class="visual" contype="0" conaffinity="0" />
      <geom mesh="hand_4" material="off_white_trans" class="visual" contype="0" conaffinity="0" />
      <geom mesh="hand_c" class="collision" contype="0" conaffinity="0"/>
      
      <site name="hand_copy_site" pos="0 0 0.1034"/>
      
      <body name="left_finger_copy" pos="0 0 0.0584">
        <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
        <geom mesh="finger_0" material="off_white_trans" class="visual" contype="0" conaffinity="0" />
        <geom mesh="finger_1" material="black_trans" class="visual" contype="0" conaffinity="0" />
        <geom mesh="finger_0" class="collision" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_1" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_2" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_3" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_4" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_5" contype="0" conaffinity="0" />
      </body>
      
      <body name="right_finger_copy" pos="0 0 0.0584" quat="0 0 0 1">
        <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
        <geom mesh="finger_0" material="off_white_trans" class="visual" contype="0" conaffinity="0" />
        <geom mesh="finger_1" material="black_trans" class="visual" contype="0" conaffinity="0" />
        <geom mesh="finger_0" class="collision" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_1" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_2" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_3" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_4" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_5" contype="0" conaffinity="0" />
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="world" body2="left_finger"/>
    <exclude body1="world" body2="right_finger"/>
    <exclude body1="left_finger" body2="right_finger"/>
  </contact>

  <keyframe>
    <!-- <key name="home" qpos="-0.026895 0.391451 0.0199961 0.959693 0 0 -0.281049 1.00714 0.42312 -0.00198696 -1.65569 -0.05794 2.28189 0.393188 0.005 0.005"/>
     -->
     <!-- <key name="home" qpos="-0.026895 0.391451 0.0199961 0.959693 0 0 -0.281049 1.00714 0.42312 -0.00198696 -1.65569 -0.05794 2.28189 0.393188"/> -->
     <key name="home" qpos="0 0 0 -1.57079 0 1.57079 -0.7853  "/>
  </keyframe>

  <sensor>
  <!-- ==== Stage-2: EE position tracking ====
       Sampling fixed at Stage-1 best. Reach_pos active (sweep weight),
       Reach_ori still off. mocap is locked to robot's initial EE pos via
       <numeric name="home_lock_mocap" data="1"/>, so the target is whatever
       EE position results from the home keyframe pose. With jc=100 still
       pulling toward q_mid, this is a 7-DoF redundancy contest.
  -->
    <!-- After residual normalization (residual = drift / scale), same weight
         applies to both. SWEEP weight {1, 3, 10, 30, 100, 300}. -->
    <user name="Reach_pos" dim="3" user="2 1000 0 50000 0.01"/>
    <user name="Press_z"   dim="1" user="2 0 0 100 0.01"/>
    <user name="Reach_ori" dim="3" user="2 1000 0 50000 0.01"/>

    <!-- Joint centering toward jnt_range midpoint (Stage-1 best). -->
    <user name="joint_cent" dim="7" user="2 100 0 1000 1"/>

    <!-- Joint velocity hard hinge: residual = max(0, |qdot| - limit).
         Large weight = stiff barrier. -->
    <user name="joint_vel_penalty" dim="7" user="2 100000 0 1000000 0.01"/>

    <!-- Joint position limit hard hinge near jnt_range bounds.
         Large weight = stiff barrier. -->
    <user name="joint_pos_limit" dim="7" user="2 100000 0 1000000 1"/>

    <user name="EE_Force_track" dim="1" user="2 0 0 1 1"/>
    <user name="EE_Force_reg"   dim="2" user="2 0 0 0.1 1"/>
    <user name="u_reg" dim="7" user="2 0 0 0.1 0.01"/>

    <user name="manip_barrier" dim="1" user="2 0 0 10 1"/>
    <user name="ee_z_vel_damp" dim="1" user="2 0 0 10 1"/>

    <framepos name="hand" objtype="site" objname="hand_site"/>
    <framequat name="hand_orient" objtype="site" objname="hand_site"/>

    <framequat name="hand_target_orient" objtype="site" objname="hand_copy_site"/>
    <framepos name="hand_target" objtype="site" objname="hand_copy_site"/>

    <framepos name="trace0" objtype="site" objname="hand_site"/>

    <!-- WIP CHUNK 2: hand_force sensor -->
    <force name="hand_force" site="hand_site"/>
  </sensor>

  <!-- modified from: https://github.com/google-deepmind/mujoco_menagerie/tree/main/franka_emika_panda -->
  <include file="panda_modified.xml"/>

  <!-- Contact + numerical-stability options adopted from MJPC's
       manipulation/task_panda_bring (the in-tree pick-and-place benchmark).
       Placed AFTER the panda include so this <option> wins the merge over
       panda_modified.xml's own timestep=0.002 (MuJoCo merges with last-write
       priority per attribute):
         timestep=0.001     1 kHz sim → finer resolution of contact transients
         cone="elliptic"    smoother / more accurate friction cone
         integrator="implicit"  stable for stiff contact dynamics
         flag multiccd      multiple contact points per geom pair (e.g. both
                            fingers touching the table) so reaction force is
                            distributed instead of all going through one point. -->
  <option timestep="0.001" cone="elliptic" integrator="implicit">
    <flag multiccd="enable"/>
  </option>
</mujoco>
