<mujoco model="Fr3">
  <include file="../common.xml"/>

  <!-- nuserdata reserves slots in mjData->userdata for sharing between
       TransitionLocked (writes) and the cost functions (read).
       Layout: [0..2] = traj_final_mocap_ (xyz), [3] = hybrid_active flag. -->
  <size memory="1M" nuserdata="5"/>

  <custom>
    <numeric name="agent_planner" data="0" />
    <!-- <numeric name="agent_horizon" data="0.2" />  
    <numeric name="agent_timestep" data="0.01" /> -->

    <!-- horizon/dt match reference tau-MPPI: T=40 steps, dt=0.01 -->
    <!-- dt was changed from 0.003 to 0.01 caused by the change in agent_timestep and for safety -->
    <numeric name="agent_horizon" data="0.3" />
    <numeric name="agent_timestep" data="0.01" />

    <numeric name="agent_policy_width" data="0.0035" />
    <numeric name="sampling_trajectories" data="128"/>
    <!-- Dense per-step control: 40 zero-spline knots over the horizon. -->
    <numeric name="sampling_spline_points" data="40" />
    <!-- 0=Zero, 1=Linear, 2=Cubic, 3=Bezier. Reference uses dense per-step (Zero). -->
    <numeric name="sampling_representation" data="0" />
    <!-- Global multiplier on per-joint sigma (reference uses raw sigma -> 1.0). -->
    <numeric name="sampling_exploration" data="1.0" />
    <!-- MPPI temperature: matches reference _lambda = 1.0. -->
    <!-- λ = 0.1/13 to compensate mjpc's cost-averaging over horizon=13. -->
    <numeric name="sampling_lambda" data="0.1" />
    <!-- DC noise (one offset per rollout-joint, broadcast to all knots). -->
    <numeric name="sampling_dc_noise" data="1" />
    <!-- Per-joint sigma in N*m, matches reference _sigma = {2,2,2,2,1,1,1}. -->
    <numeric name="sampling_std_per_joint" size="7" data="2 2 2 2 1 1 1" />
    <numeric name="gradient_spline_points" data="6" />
    <!-- // =============== EC =============== // -->
    <!-- WIP CHUNK 3: force-control numerics -->
    <numeric name="F_des" size="3" data="0 0 -10"/>
    <!-- Subtree weight of hand_site's parent body: hand (0.73) + two
         fingers (0.015 each) = 0.76 kg → 7.46 N. Used to remove the
         gravity bias from the hand_force sensor when computing
         F_press_z. Retune if the EE assembly changes. -->
    <numeric name="ee_weight_N" data="7.46"/>
    <numeric name="approach_time"    data="2.0"/>
    <!-- Goal-reach criterion for switching from approach -> hybrid:
         EE site within `hybrid_switch_dist` (m) AND
         orientation axis-angle error < `hybrid_switch_angle` (rad).
         After both met, wait `hybrid_switch_delay` (s) before switching. -->
    <numeric name="hybrid_switch_dist"  data="0.02"/>
    <numeric name="hybrid_switch_angle" data="0.087"/>  <!-- ~5 deg -->
    <numeric name="hybrid_switch_delay" data="0.5"/>
    <!-- // ================================== // -->
  </custom>

  <statistic extent="1.5" center="0.1 0.2 0.3"/>

  <visual>
    <quality shadowsize="8192"/>
    <global azimuth="180" elevation="-30"/>
    <scale framelength=".3" framewidth=".03"/>
  </visual>

  <default>
    <geom solref=".001 1"/>
  </default>

  <asset>
    <material class="panda" name="white_trans" rgba="1 1 1 0.3"/>
    <material class="panda" name="off_white_trans" rgba="0.901961 0.921569 0.929412 0.3"/>
    <material class="panda" name="black_trans" rgba="0.25 0.25 0.25 0.3"/>
  </asset>

  <compiler texturedir="./textures"/>

  <worldbody>
    <site name="world"/>
    <light pos="0 -0.1 0.5" dir="0 0.2 -1" diffuse="0.7 0.7 0.7" specular="0.3 0.3 0.3"
        directional="true" castshadow="true"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane" material="blue_grid"/>

    <!-- Table matched to reference scene_table.xml (used by MPPI_tau.cu):
         body @ (0.45, 0, 0), top geom at body-local (0,0,0.28) with size
         0.30 × 0.35 × 0.02 → top surface world z = 0.30. friction 1.0,
         soft contact (solref 0.04 / solimp 0.9 0.99 0.001), condim 3. -->
    <body name="table" pos="0.45 0.0 0.0">
      <geom name="table_top" type="box" pos="0 0 0.28" size="0.30 0.35 0.02"
            rgba="0.55 0.35 0.18 1" friction="1 0.005 0.0001"
            contype="1" conaffinity="1"
            condim="3" solimp="0.9 0.99 0.001" solref="0.04 1"/>
      <geom name="leg_fl" type="cylinder" pos=" 0.25  0.30 0.13" size="0.02 0.13"
            rgba="0.4 0.25 0.12 1" contype="0" conaffinity="0"/>
      <geom name="leg_fr" type="cylinder" pos=" 0.25 -0.30 0.13" size="0.02 0.13"
            rgba="0.4 0.25 0.12 1" contype="0" conaffinity="0"/>
      <geom name="leg_bl" type="cylinder" pos="-0.25  0.30 0.13" size="0.02 0.13"
            rgba="0.4 0.25 0.12 1" contype="0" conaffinity="0"/>
      <geom name="leg_br" type="cylinder" pos="-0.25 -0.30 0.13" size="0.02 0.13"
            rgba="0.4 0.25 0.12 1" contype="0" conaffinity="0"/>
    </body>


    <!-- <body name="target" mocap="true" pos="0.6 0.4 0.05">
      <geom name="target"  type="box" size="0.02 0.03 0.02" contype="0" conaffinity="0" rgba=".5 .5 .5 .3"/>
      <site name="target1" type="box" pos="0  .026 0" size="0.021 0.005 0.021" rgba="1 .1 .1 .3"/>
      <site name="target2" type="box" pos="0 -.026 0" size="0.021 0.005 0.021" rgba=".1 .1 1 .3"/>
    </body> -->


    <!-- <body name="box" pos="0.4 0.0 0.5" mocap="true">
      <freejoint/>
      <geom name="box"  type="box" size="0.02 0.03 0.02" priority="1" condim="6" friction="1 .01 .003"/>
      <geom name="box"  type="box" size="0.02 0.03 0.02" contype="0" conaffinity="0" rgba=".5 .5 .5 .3"/>
      <site name="box1" type="box" pos="0  .026 0" size="0.021 0.005 0.021" rgba="1 .1 .1 1"/>
      <site name="box2" type="box" pos="0 -.026 0" size="0.021 0.005 0.021" rgba=".1 .1 1 1"/>
    </body> -->

    <!--  hand_copy -->
    <!-- <body name="hand_copy" pos="0.5 0.3 0.5" quat="0.9238795 0 0 -0.3826834" mocap="true"> -->
    <body name="hand_copy" pos="0.5 0.3 0.5" quat="0 1 0 0" mocap="true">
      <inertial mass="0.73" pos="-0.01 0 0.03" diaginertia="0.001 0.0025 0.0017"/>
      <geom mesh="hand_0" material="off_white_trans" class="visual" contype="0" conaffinity="0"  />
      <geom mesh="hand_1" material="black_trans" class="visual" contype="0" conaffinity="0" />
      <geom mesh="hand_2" material="black_trans" class="visual" contype="0" conaffinity="0" />
      <geom mesh="hand_3" material="white_trans" class="visual" contype="0" conaffinity="0" />
      <geom mesh="hand_4" material="off_white_trans" class="visual" contype="0" conaffinity="0" />
      <geom mesh="hand_c" class="collision" contype="0" conaffinity="0"/>
      
      <site name="hand_copy_site" pos="0 0 0.1034"/>
      
      <body name="left_finger_copy" pos="0 0 0.0584">
        <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
        <geom mesh="finger_0" material="off_white_trans" class="visual" contype="0" conaffinity="0" />
        <geom mesh="finger_1" material="black_trans" class="visual" contype="0" conaffinity="0" />
        <geom mesh="finger_0" class="collision" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_1" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_2" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_3" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_4" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_5" contype="0" conaffinity="0" />
      </body>
      
      <body name="right_finger_copy" pos="0 0 0.0584" quat="0 0 0 1">
        <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
        <geom mesh="finger_0" material="off_white_trans" class="visual" contype="0" conaffinity="0" />
        <geom mesh="finger_1" material="black_trans" class="visual" contype="0" conaffinity="0" />
        <geom mesh="finger_0" class="collision" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_1" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_2" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_3" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_4" contype="0" conaffinity="0" />
        <geom class="fingertip_pad_collision_5" contype="0" conaffinity="0" />
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="world" body2="left_finger"/>
    <exclude body1="world" body2="right_finger"/>
    <exclude body1="left_finger" body2="right_finger"/>
  </contact>

  <keyframe>
    <!-- <key name="home" qpos="-0.026895 0.391451 0.0199961 0.959693 0 0 -0.281049 1.00714 0.42312 -0.00198696 -1.65569 -0.05794 2.28189 0.393188 0.005 0.005"/>
     -->
     <!-- <key name="home" qpos="-0.026895 0.391451 0.0199961 0.959693 0 0 -0.281049 1.00714 0.42312 -0.00198696 -1.65569 -0.05794 2.28189 0.393188"/> -->
     <key name="home" qpos="0 0 0 -1.57079 0 1.57079 0"/>
  </keyframe>

  <sensor>
  <!-- user format: "type, weight, weight_lower, weight_upper, p_smooth"
       Final cost = weight * sum(residual^2). Weights below match reference
       tau-MPPI: Q_p=1e6, Q_o=5e4, qdot=500, null=1000, plus a soft hinge that
       approximates the reference's hard penalty on velocity / joint limits.
  -->
    <!-- Match reference MPPI_tau.cu raw quadratic costs.
         mjpc kQuadratic (norm_type=0) is 0.5·‖x‖², so weight = 2·Q to
         align with reference's   cost = Q·‖x‖²   and gradient = 2Q·x.
           Reference Q       →   mjpc weight (= 2·Q)
           Q_p   = 1e6              2e6     (Reach_pos)
           Q_o   = 5e4              1e5     (Reach_ori)
           null  = 1000             2000    (joint_cent)
           qdot  = 500              1000    (joint_vel)
           Force = 10               20      (EE_Force)
         The 5th xml number is the Norm parameter; for kQuadratic it is
         unused (kept at the previous values for compatibility). -->
    <user name="Reach_pos"         dim="3" user="2 1000000 0 5000000  0.01"/>
    <user name="Reach_ori"         dim="3" user="2 50000   0 500000   0.01"/>
    <user name="joint_cent"        dim="7" user="2 1000    0 5000     1"/>
    <user name="joint_vel_penalty" dim="7" user="2 500     0 5000     0.01"/>
    <user name="EE_Force"          dim="3" user="2 30      0 100      1"/>
    <user name="u_reg"             dim="7" user="2 0.01    0 1        0.01"/>

    <framepos name="hand" objtype="site" objname="hand_site"/>
    <framequat name="hand_orient" objtype="site" objname="hand_site"/>

    <framequat name="hand_target_orient" objtype="site" objname="hand_copy_site"/>
    <framepos name="hand_target" objtype="site" objname="hand_copy_site"/>

    <framepos name="trace0" objtype="site" objname="hand_site"/>

    <!-- WIP CHUNK 2: hand_force sensor -->
    <force name="hand_force" site="hand_site"/>
  </sensor>

  <!-- modified from: https://github.com/google-deepmind/mujoco_menagerie/tree/main/franka_emika_panda -->
  <include file="panda_modified.xml"/>
</mujoco>
