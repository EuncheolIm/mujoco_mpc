<mujoco model="Fr3HGripper">
  <!-- 62-DOF closed-loop H-gripper: bump memory / constraint limits. -->
  <size memory="50M" nuserdata="5"/>

  <custom>
    <numeric name="agent_planner" data="14"/>          <!-- FlowMPPIRpy (FM goal=pos+rpy) -->
    <numeric name="agent_horizon" data="0.20"/>
    <numeric name="agent_timestep" data="0.01"/>
    <numeric name="agent_policy_width" data="0.0035"/>
    <numeric name="sampling_trajectories" data="32"/>
    <numeric name="sampling_spline_points" data="30"/>
    <numeric name="sampling_representation" data="0"/>   <!-- Zero-order (torque, dense) -->
    <numeric name="sampling_exploration" data="1.0"/>
    <numeric name="sampling_lambda" data="1000"/>
    <numeric name="sampling_dc_noise" data="1"/>
    <!-- nu=10: arm 7 (torque N*m) + gripper 3 held (std 0, not sampled). -->
    <numeric name="sampling_std_per_joint" size="7" data="2 2 2 2 1 1 1"/>
    <numeric name="gradient_spline_points" data="6"/>
    <!-- FM cost-bias target (arm 7); default = home. Updated by planner UpdateFM. -->
    <numeric name="q_fm_target" size="7" data="0 -0.6 0 -2.2 0 1.6 0.8"/>
  </custom>

  <statistic extent="0.8" center="0.3 0 0.4"/>
  <visual>
    <global azimuth="120" elevation="-20"/>
    <scale framelength="0.3" framewidth="0.03"/>
  </visual>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <site name="world"/>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" diffuse="0.7 0.7 0.7"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- draggable target (mocap 0). quat 0,1,0,0 = gripper-down (goal roll ~ -pi). -->
    <body name="drag_target" mocap="true" pos="0.5 0 0.4" quat="0 1 0 0">
      <geom name="drag_geom" type="sphere" size="0.03" rgba="1 0.25 0.25 0.55"
            contype="0" conaffinity="0"/>
      <site name="target_site" pos="0 0 0" size="0.012" rgba="0 1 0 1" group="0"/>
    </body>
  </worldbody>

  <sensor>
    <!-- user = "norm_type weight w_lower w_upper p_smooth"; cost = weight*sum(res^2).
         Order MUST match Residual() concat. Total user dim = 34. -->
    <user name="Reach_pos"         dim="3" user="2 1000000 0 5000000  0.01"/>
    <user name="Reach_ori"         dim="3" user="2 50000   0 500000   0.01"/>
    <user name="joint_cent"        dim="7" user="2 20      0 5000     1"/>
    <user name="joint_vel_penalty" dim="7" user="2 500     0 5000     0.01"/>
    <user name="u_reg"             dim="7" user="2 0.01    0 1        0.01"/>
    <user name="FM_track"          dim="7" user="2 10000   0 50000    0.01"/>

    <framepos  name="hand"               objtype="site" objname="hand_site"/>
    <framequat name="hand_orient"        objtype="site" objname="hand_site"/>
    <framequat name="hand_target_orient" objtype="site" objname="target_site"/>
    <framepos  name="hand_target"        objtype="site" objname="target_site"/>
    <framepos  name="trace0"             objtype="site" objname="hand_site"/>
  </sensor>

  <include file="fr3_H_gripper.xml"/>

  <keyframe>
    <!-- arm 7 (gripper 55 padded 0). Motor actuators -> no ctrl needed. -->
    <key name="home" qpos="0 -0.6 0 -2.2 0 1.6 0.8"/>
  </keyframe>
</mujoco>
