<mujoco model="Fr3HGripperDual">
  <size memory="100M" nuserdata="5"/>

  <custom>
    <numeric name="agent_planner" data="14"/>           <!-- FlowMPPIRpy, FM OFF -> vanilla MPPI over nu=16 -->
    <numeric name="agent_horizon" data="0.4"/>            <!-- headless-tuned: longer H -> smooth stop -->
    <numeric name="agent_timestep" data="0.01"/>
    <numeric name="agent_policy_width" data="0.0035"/>
    <numeric name="sampling_trajectories" data="128"/>    <!-- headless-tuned: K=128 -->
    <numeric name="sampling_spline_points" data="16"/>
    <numeric name="sampling_representation" data="0"/>
    <numeric name="sampling_exploration" data="1.0"/>
    <numeric name="sampling_lambda" data="1000"/>         <!-- if it DIVERGES, raise this (temperature) via MJPC_LAMBDA + watch ESS -->
    <numeric name="sampling_dc_noise" data="1"/>          <!-- DC noise = stable (per-knot diverges) -->
    <!-- nu=16: (arm7 + grab_motor) x2. grippers std 0. Compromise torque std: small sigma
         (0.6/0.3) = 3mm precision but STUCK/jitter on target change; large (2/1) = responsive
         but ~15mm. This 1/0.5 balances. Real fix for both = adaptive noise (planner change). -->
    <numeric name="sampling_std_per_joint" size="16" data="1 1 1 1 0.5 0.5 0.5 0  1 1 1 1 0.5 0.5 0.5 0"/>
    <!-- per-joint cost separation (MJPC_PERJOINT=1): control-dim per arm joint,
         in joint_cent order (l1-7, r1-7). grippers (ctrl 7,15) are skipped. -->
    <numeric name="perjoint_ctrl" size="14" data="0 1 2 3 4 5 6  8 9 10 11 12 13 14"/>
  </custom>

  <statistic extent="1.0" center="0.3 0 0.4"/>
  <visual>
    <global azimuth="150" elevation="-20"/>
    <scale framelength="0.3" framewidth="0.03"/>
  </visual>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true" diffuse="0.7 0.7 0.7"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- per-arm draggable targets (mocap 0 = left, 1 = right). quat 0,1,0,0 = gripper-down. -->
    <body name="l_target" mocap="true" pos="0.5 0.3 0.5" quat="0 1 0 0">
      <geom type="sphere" size="0.025" rgba="0.2 0.6 1 0.5" contype="0" conaffinity="0"/>
      <site name="l_target_site" pos="0 0 0" size="0.012" rgba="0.2 0.6 1 1" group="0"/>
    </body>
    <body name="r_target" mocap="true" pos="0.5 -0.3 0.5" quat="0 1 0 0">
      <geom type="sphere" size="0.025" rgba="1 0.3 0.3 0.5" contype="0" conaffinity="0"/>
      <site name="r_target_site" pos="0 0 0" size="0.012" rgba="1 0.3 0.3 1" group="0"/>
    </body>
  </worldbody>

  <sensor>
    <!-- user = "norm_type weight w_lower w_upper p_smooth". Order MUST match Residual(). Total = 41. -->
    <user name="L_pos"      dim="3"  user="2 1000000 0 5000000 0.01"/>
    <user name="L_ori"      dim="3"  user="2 200000  0 2000000 0.01"/>
    <user name="R_pos"      dim="3"  user="2 1000000 0 5000000 0.01"/>
    <user name="R_ori"      dim="3"  user="2 200000  0 2000000 0.01"/>
    <user name="joint_cent" dim="14" user="2 200     0 5000    1"/>
    <user name="joint_vel"  dim="14" user="2 80      0 5000    0.01"/>
    <user name="collision"  dim="1"  user="2 500000  0 20000000 0.01"/>
    <!-- joint-limit barrier: keep arm joints off their range min/max (unusable otherwise). -->
    <user name="joint_limit" dim="14" user="2 5000000 0 50000000 0.01"/>

    <framepos  name="l_hand"        objtype="site" objname="l_hand_site"/>
    <framequat name="l_hand_quat"   objtype="site" objname="l_hand_site"/>
    <framepos  name="r_hand"        objtype="site" objname="r_hand_site"/>
    <framequat name="r_hand_quat"   objtype="site" objname="r_hand_site"/>
    <framepos  name="l_target"      objtype="site" objname="l_target_site"/>
    <framequat name="l_target_quat" objtype="site" objname="l_target_site"/>
    <framepos  name="r_target"      objtype="site" objname="r_target_site"/>
    <framequat name="r_target_quat" objtype="site" objname="r_target_site"/>
  </sensor>

  <keyframe>
    <!-- l_arm(7) l_slides(3) r_arm(7) r_slides(3) -->
    <key name="home" qpos="0 -0.6 0 -2.2 0 1.6 0.8  0 0 0  0 -0.6 0 -2.2 0 1.6 0.8  0 0 0"/>
  </keyframe>

  <include file="fr3_H_gripper_dual.xml"/>
</mujoco>
