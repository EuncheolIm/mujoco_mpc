                      <geom name="finger_C_sub_bolt_link_3" type="sphere" size="0.00670" pos="-0.035440 -0.000000 0.126000" contype="1" conaffinity="1" mass="0" group="1" rgba="0.2 0.8 0.3 0.35"/>
                      <geom name="finger_C_sub_rot_joint_4" type="sphere" size="0.00670" pos="-0.055440 -0.000000 0.126000" contype="1" conaffinity="1" mass="0" group="1" rgba="0.2 0.8 0.3 0.35"/>
                      <geom name="finger_C_sub_rot_joint_8" type="sphere" size="0.00670" pos="-0.074440 0.000000 0.048000" contype="1" conaffinity="1" mass="0" group="1" rgba="0.2 0.8 0.3 0.35"/>
