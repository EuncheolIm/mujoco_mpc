  <equality>
    <!-- finger B and C slides slaved 1:1 to A -> single driven grasp DOF (grab_motor on A). -->
    <joint name="finger_slide_1" joint1="finger_A_slide_joint" joint2="finger_B_slide_joint" polycoef="0 1 0 0 0" solref="0.002 1"/>
    <joint name="finger_slide_2" joint1="finger_A_slide_joint" joint2="finger_C_slide_joint" polycoef="0 1 0 0 0" solref="0.002 1"/>
    <!-- GRASP WELD, hand <-> box. Starts inactive; the phase machine captures the
         hand-frame relpose into eq_data and flips eq_active a fixed delay after the
         close command. The real Hyundai gripper does not let the box slip, so modelling
         the hold as friction only reproduced a sim artefact.
         SCOPE: eq_active lives in mjData and mjpc never copies it into rollout data
         (trajectory.cc copies qpos/qvel/act/userdata/time and nothing else), so the
         weld binds the GUI physics only. The planner keeps rolling out a free box on
         the floor. That is acceptable here BECAUSE no cost term reads the object: the
         only consequence is that rollouts do not feel the 0.5 kg payload. -->
    <weld name="grasp" body1="hand" body2="sugar_box" active="false" torquescale="1"/>
  </equality>

  <actuator>
    <motor name="actuator1" joint="fr3_joint1" ctrllimited="true" ctrlrange="-87.0 87.0" />
    <motor name="actuator2" joint="fr3_joint2" ctrllimited="true" ctrlrange="-87.0 87.0" />
    <motor name="actuator3" joint="fr3_joint3" ctrllimited="true" ctrlrange="-87.0 87.0" />
    <motor name="actuator4" joint="fr3_joint4" ctrllimited="true" ctrlrange="-87.0 87.0" />
    <motor name="actuator5" joint="fr3_joint5" ctrllimited="true" ctrlrange="-12.0 12.0" />
    <motor name="actuator6" joint="fr3_joint6" ctrllimited="true" ctrlrange="-12.0 12.0" />
    <motor name="actuator7" joint="fr3_joint7" ctrllimited="true" ctrlrange="-12.0 12.0" />

    <!-- gripper grasp actuator (drives finger_A slide; B/C follow via equality). judo gpu_grab 상당.
         kp high enough that the closing force saturates forcerange -> grip force = 10N
         (real gripper's set grasp force). kv damps the fast slide. -->
    <position name="grab_motor" joint="finger_A_slide_joint" kp="200" kv="40" ctrllimited="true" ctrlrange="-0.1 0.1" forcerange="-40 40"/>
    </actuator>
  <!-- FINGERTIP TOUCH SENSORS. Reading contact through sensors instead of scanning
       data->contact for hardcoded geom names ("sugar_box_geom") matters twice over: it does
       not break when the object changes, and it mirrors what the hardware actually gives us
       -- GripperStatus carries a binary CONTACT bit, so a thresholded touch force is the
       same kind of signal on both sides.
       These are mjSENS_TOUCH, not mjSENS_USER, so they do not affect the user-sensor
       dimension that Residual() must match. -->
  <sensor>
    <touch name="pad1_touch" site="gripper_pad_1_site"/>
    <touch name="pad2_touch" site="gripper_pad_2_site"/>
    <touch name="pad3_touch" site="gripper_pad_3_site"/>
  </sensor>

