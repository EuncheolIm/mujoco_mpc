    <!-- object freed to be grasped (judo-style): free body on the floor.
         contype/conaffinity=1 -> collides with the fingertip pads (group 1) and floor. -->
    <body name="sugar_box" pos="0.5 0 0.087">
      <freejoint name="box_free"/>
      <!-- mass 0.5. DO NOT drop this to ~10 g. Tried 0.01 kg to remove the payload
           mismatch against an empty real hand, and it broke the task in 3/3 runs: the
           object was pinched, then flung out of the pads mid-carry and the arm diverged.
           Two reasons, both about the box being too light rather than about the plan:
             * the pads are driven by a kp=1000 position actuator, and a 10 g body simply
               loses that argument -- it squirts out from between them (the same failure
               the finger-slide coupling comment further down was written for);
             * once it leaves, Object_tgt (3e6) is a huge cost on an object the arm no
               longer controls, so the planner answers with everything it has.
           The payload mismatch is real, but the fix is to use the OBJECT'S ACTUAL MASS,
           not to make it nearly massless. The tuned Object_tgt/Carry_vel weights in
           task.xml were measured at 0.5 kg.
           CONTACT geom: still a box, now at the mesh's measured half-extents
           (49.5/2, 94.1/2, 176.0/2 mm). Kept as a primitive on purpose -- MuJoCo would
           collide a mesh through its convex hull, and paying for that on every one of
           32 rollouts x 0.225 s is not affordable on this machine. group 3 = the
           model's collision group, so it does not clutter the view. -->
      <geom name="sugar_box_geom" type="box" size="0.0200 0.0470 0.087" mass="0.5"
            rgba="0.9 0.75 0.1 0.3" contype="1" conaffinity="1" group="3"/>
      <!-- VISUAL geom: the scanned mesh. No collision, no mass (the box above owns
           both), pos cancels the mesh's bounding-box centre offset. -->
      <geom name="sugar_mesh_geom" type="mesh" mesh="sugar_mesh"
            rgba="0.85 0.7 0.15 1" pos="-0.0009 0.0015 0.0044" mass="0"
            contype="0" conaffinity="0" group="1"/>
      <site name="object_site" pos="0 0 0" size="0.008" rgba="0.9 0.75 0.1 1" group="0"/>
    </body>
  </worldbody>

  
