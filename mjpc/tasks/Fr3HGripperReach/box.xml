<mujoco model="reach_box">
  <!-- CONTROL EXPERIMENT (MJPC_REACH_BOX=1): the same sugar box the Carry task
       uses, dropped into the settled REACH task. Nothing else changes, so a reach
       to "object + 7 cm along the approach axis" can be compared against the
       phase-1 behaviour of Fr3HGripperCarry's state machine: same object, same
       gripper, same offset, but the reach task's own cost mixture (Reach_pos 1e6
       + gripper-down Reach_ori 6e5) instead of Carry's Hand_obj / Object_tgt.
       Included AFTER the arm so the box's free joint is the LAST 7 qpos entries,
       matching Carry. -->
  <worldbody>
    <body name="sugar_box" pos="0.5 0 0.088">
      <freejoint name="box_free"/>
      <geom name="sugar_box_geom" type="box" size="0.0225 0.045 0.0875" mass="0.5"
            rgba="0.9 0.75 0.1 1" contype="1" conaffinity="1"/>
      <site name="object_site" pos="0 0 0" size="0.008" rgba="0.9 0.75 0.1 1" group="0"/>
    </body>
  </worldbody>
</mujoco>
