<mujoco model="Fr3HGripperReach">
  <size memory="50M" nuserdata="5"/>

  <!-- MATCH-MPPI_Reach: this whole block is Fr3Reach/task.xml's <custom> verbatim.
       Removed relative to the original Fr3HGripperReach: every sampling_sigma_adapt_*
       numeric (Fr3Reach has none, so the planner treats it as OFF) and perjoint_ctrl.
       sampling_std_per_joint MUST have exactly model->nu entries or the planner calls
       mju_error_i -- it is 7 now only because grab_motor is commented out. -->
  <custom>
    <numeric name="agent_planner" data="9" />
    <numeric name="agent_horizon" data="0.30" />
    <numeric name="agent_timestep" data="0.01" />
    <numeric name="agent_policy_width" data="0.0035" />
    <numeric name="sampling_trajectories" data="128"/>
    <numeric name="sampling_spline_points" data="30" />
    <numeric name="sampling_representation" data="0" />
    <numeric name="sampling_exploration" data="1.0" />
    <numeric name="sampling_lambda" data="0.1" />
    <numeric name="sampling_dc_noise" data="1" />
    <numeric name="sampling_std_per_joint" size="7" data="2 2 2 2 1 1 1" />
    <numeric name="gradient_spline_points" data="6" />
    <!-- Settle latch. The planner shrinks sigma once the task-space error is inside
         MJPC_SIGMA_ADAPT_THR (pos, m) and THR_ORI (rad), and restores it the moment the
         error exceeds hyst x that -- so a disturbance always brings full exploration,
         and with it the H=0.20 compliance, straight back. Only this numeric lives here;
         everything else is env-tunable, but the env override sits INSIDE the
         `if (sigma_adapt_ > 0)` gate in the planner, so the numeric must be present or
         MJPC_SIGMA_ADAPT does nothing. -->
    <numeric name="sampling_sigma_adapt" data="1"/>
    <numeric name="q_fm_target" size="7" data="0 -0.78539816 0 -2.35619449 0 1.57079632 0.78539816"/>
  </custom>

  <statistic extent="1.0" center="0.3 0 0.4"/>
  <visual>
    <global azimuth="150" elevation="-20"/>
    <scale framelength="0.3" framewidth="0.03"/>
  </visual>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true" diffuse="0.7 0.7 0.7"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- draggable reach target (mocap 0). quat 0,1,0,0 = gripper-down. -->
    <body name="target" mocap="true" pos="0.5 0 0.5" quat="0 1 0 0">
      <geom type="sphere" size="0.025" rgba="0.2 0.6 1 0.5" contype="0" conaffinity="0"/>
      <site name="target_site" pos="0 0 0" size="0.012" rgba="0.2 0.6 1 1" group="0"/>
    </body>
  </worldbody>

  <!-- MATCH-MPPI_Reach: weights and names are Fr3Reach/task.xml's.
       Dropped joint_limit (5e6) and nullspace_vel (5000) -- Fr3Reach has neither.
       Added FM_track, which Fr3Reach has; it is inert while MJPC_FM_TRACK_SCALE=0.
       Reach_ori 600000 -> 50000. Names must stay as-is: Fr3Reach's cost_fn resolves
       them with SensorByName("hand"/"hand_orient"/"hand_target"/"hand_target_orient"). -->
  <sensor>
    <user name="Reach_pos"         dim="3" user="2 1000000 0 5000000  0.03"/>
    <user name="Reach_ori"         dim="3" user="2 50000   0 500000   0.01"/>
    <user name="joint_cent"        dim="7" user="2 20    0 5000     1"/>
    <user name="joint_vel_penalty" dim="7" user="2 500     0 5000     0.01"/>
    <user name="u_reg"             dim="7" user="2 0.01    0 1        0.01"/>
    <user name="FM_track"          dim="7" user="2 10000   0 50000    0.01"/>

    <framepos  name="hand"               objtype="site" objname="hand_site"/>
    <framequat name="hand_orient"        objtype="site" objname="hand_site"/>
    <framepos  name="hand_target"        objtype="site" objname="target_site"/>
    <framequat name="hand_target_orient" objtype="site" objname="target_site"/>
    <framepos  name="trace0"             objtype="site" objname="hand_site"/>
  
    <!-- MEASUREMENT ALIASES for hgripper_settle_eval, which resolves these exact
         names. Not user sensors, so they do not enter the residual. -->
    <framequat name="hand_quat"   objtype="site" objname="hand_site"/>
    <framepos  name="target"      objtype="site" objname="target_site"/>
    <framequat name="target_quat" objtype="site" objname="target_site"/>
  </sensor>

  <keyframe>
    <!-- arm(7) only: the finger slides are welded (MATCH-MPPI_Reach) -->
    <!-- MATCH-MPPI_Reach: Fr3Reach's home. The goal ORIENTATION is captured at this
         pose (see TransitionLocked), so the home pose selects the goal. -->
    <key name="home" qpos="0 -0.78539816 0 -2.35619449 0 1.57079632 0.78539816"/>
  </keyframe>

  <!-- RIGID GRIPPER: the 60-body subtree collapsed to one body. Mass, COM, inertia
       and the home gravity torques all match the original to ~1e-9 (see
       /tmp/carry_eval/verify.py). Flip back for Carry / hardware. -->
  <!-- <include file="fr3_H_gripper_single.xml"/> -->
  <include file="fr3_H_gripper_rigid.xml"/>
</mujoco>
