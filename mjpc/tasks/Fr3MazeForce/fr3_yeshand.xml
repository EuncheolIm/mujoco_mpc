                           radius small so it threads through tight maze gaps. -->
                      <geom name="stylus" type="capsule" pos="0 0 0.255"
                            size="0.012 0.04"
                            rgba="0.85 0.85 0.95 1"
                            contype="1" conaffinity="1"
                            friction="0.5 0.005 0.0001"
                            solref=".005 1"/>
