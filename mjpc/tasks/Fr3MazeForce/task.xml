<mujoco model="Fr3MazeForce">
  <include file="../common.xml"/>

  <!-- userdata layout: [0..2] = traj_final_mocap_(xyz), [3] = hybrid flag,
                        [4] = (reserved, mirrors wipe task's wipe-origin slot). -->
  <size memory="1M" nuserdata="5"/>

  <custom>
    <!-- Step 1 default = MPPI baseline. Step 3 will switch to 9 (FlowMPPI). -->
    <numeric name="agent_planner" data="0"/>
    <numeric name="agent_horizon" data="0.10"/>
    <numeric name="agent_timestep" data="0.01"/>

    <numeric name="agent_policy_width" data="0.0035"/>
    <numeric name="sampling_trajectories" data="128"/>
    <numeric name="sampling_spline_points" data="30"/>
    <numeric name="sampling_representation" data="0"/>
    <numeric name="sampling_exploration" data="1.0"/>
    <numeric name="sampling_lambda" data="0.1"/> <!-- best=0.1/Higher lambda → more likely to accept worse samples, which helps MPPI explore around the gates. -->
    <numeric name="sampling_dc_noise" data="1"/>
    <numeric name="sampling_std_per_joint" size="7" data="2 2 2 2 1 1 1"/>
    <numeric name="gradient_spline_points" data="6"/>

    <!-- Reach target past gate2 (x>0.57) so stylus must thread both gates.
         z=0.30 sits at table_top; force tracking owns the press. -->
    <numeric name="reach_target_xyz" size="3" data="0.65  0.00 0.30"/>
    <numeric name="gate1_xyz"        size="3" data="0.50  0.10 0.34"/>
    <numeric name="gate2_xyz"        size="3" data="0.62 -0.10 0.34"/>
    <!-- Legacy soft-gate params (no longer used; whole-arm capsule check
         reads gate geom_xpos/geom_size + gate_margin instead). -->
    <numeric name="gate_half_width"  data="0.08"/>
    <numeric name="gate_sigma_x"     data="0.05"/>
    <!-- Safety margin on top of (tube_radius + wall_half_thickness). -->
    <numeric name="gate_margin"      data="0.02"/>

    <!-- FM-as-cost-bias default (HOME_Q). FlowMPPI overwrites at runtime. -->
    <numeric name="q_fm_target" size="7" data="0 -0.78539816 0 -2.35619449 0 1.57079632 0.78539816"/>

    <!-- Hybrid (approach -> force) parameters, copied from wipe task. -->
    <numeric name="approach_z"          data="0.35"/>
    <numeric name="hybrid_switch_dist"  data="0.02"/>
    <numeric name="hybrid_switch_angle" data="0.087"/>
    <numeric name="hybrid_switch_delay" data="0.5"/>

    <!-- Force target in world frame (-z press into table). -->
    <numeric name="F_des" size="3" data="0 0 -10"/>

    <!-- Wipe (polishing) trajectory parameters. Identical to MPPI_Force task.
         Active only after the hybrid phase has begun. -->
    <!-- Linear-motion trajectory (replaces wipe circle).
         wipe_stabilize: dwell after hybrid entry before linear move begins.
         linear_duration: time to lerp mocap_xy from start to target.
         linear_start_xyz: lerp start (xy used; z taken from target).
         Stylus first descends at linear_start_xyz, dwells, then sweeps to
         reach_target_xyz while maintaining z-force on the table. -->
    <!-- Phase 1 (approach) target xy — matches MPPI_Force wipe-task target.
         Stylus descends at this xy first; then Phase 2 engages force
         tracking at the same xy; finally Phase 3 swaps mocap_xy to the
         maze goal (reach_target_xyz). -->
    <numeric name="approach_xyz" size="3" data="0.40 0.00 0.30"/>
    <!-- Time (s) Phase 2 (hybrid at approach_xy) holds before Phase 3
         (hybrid at reach_target_xy) engages. -->
    <numeric name="phase2_dwell" data="2.0"/>
    <!-- Time (s) over which Phase 3 mocap_xy ramps from approach_xy to
         reach_target_xy. Step (0.0) makes the stylus lift off contact;
         a few seconds keeps contact while sliding. -->
    <numeric name="phase3_ramp_time" data="3.0"/>

    <!-- Trajectory phases:
         Phase A (descent_time s): home EE -> (home_x, home_y, target_z).
         Phase B (linear_time s):  (home_x, home_y, target_z) -> target.
         After both, mocap holds at target.
         Step 2: both = 0 → mocap pinned at target from t=0 (step target).
                 MPPI searches the gate-avoiding path freely. -->
    <numeric name="descent_time" data="0.0"/>
    <numeric name="linear_time"  data="0.0"/>
  </custom>

  <statistic extent="0.8" center="0.2 0 0.4"/>

  <visual>
    <quality shadowsize="8192"/>
    <global azimuth="120" elevation="-20"/>
    <scale framelength=".3" framewidth=".03"/>
  </visual>

  <default>
    <geom solref=".001 1"/>
  </default>

  <worldbody>
    <site name="world"/>
    <light pos="0 -0.1 0.5" dir="0 0.2 -1" diffuse="0.7 0.7 0.7" specular="0.3 0.3 0.3"
        directional="true" castshadow="true"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane" material="blue_grid"/>

    <!-- Table that the stylus contacts (z-direction force control surface).
         table_top center z = 0.295 + half_z=0.005 → top face at z = 0.30.
         Gate wall centers at z=0.34 sit ~4 cm above the table.
         friction is light so stylus slides freely along the surface. -->
    <body name="table" pos="0.55 0.0 0.0">
      <geom name="table_top" type="box" pos="0 0 0.295" size="0.30 0.40 0.005"
            rgba="0.55 0.35 0.18 1" friction="0.5 0.005 0.0001"
            contype="1" conaffinity="1" condim="3"
            solimp="0.9 0.99 0.001" solref="0.005 1"/>
      <geom name="leg_fl" type="cylinder" pos=" 0.25  0.30 0.145" size="0.02 0.145"
            rgba="0.4 0.25 0.12 1" contype="0" conaffinity="0"/>
      <geom name="leg_fr" type="cylinder" pos=" 0.25 -0.30 0.145" size="0.02 0.145"
            rgba="0.4 0.25 0.12 1" contype="0" conaffinity="0"/>
      <geom name="leg_bl" type="cylinder" pos="-0.25  0.30 0.145" size="0.02 0.145"
            rgba="0.4 0.25 0.12 1" contype="0" conaffinity="0"/>
      <geom name="leg_br" type="cylinder" pos="-0.25 -0.30 0.145" size="0.02 0.145"
            rgba="0.4 0.25 0.12 1" contype="0" conaffinity="0"/>
    </body>

    <!-- Gate 1 walls (blue). Gap y in [+0.02, +0.18] (half-width 0.08). -->
    <body name="gate1_walls" pos="0.45 0 0.34">
      <geom name="gate1_top"    type="box" pos="0  0.28 0" size="0.015 0.10 0.04"
            rgba="0.15 0.40 0.95 0.65" contype="1" conaffinity="1" solref=".005 1" friction="0.05 0.005 0.0001"/>
      <geom name="gate1_bottom" type="box" pos="0 -0.10 0" size="0.015 0.12 0.04"
            rgba="0.15 0.40 0.95 0.65" contype="1" conaffinity="1" solref=".005 1" friction="0.05 0.005 0.0001"/>
    </body>
    <!-- Gate 2 walls (orange). Gap y in [-0.18, -0.02] (half-width 0.08). -->
    <body name="gate2_walls" pos="0.57 0 0.34">
      <geom name="gate2_top"    type="box" pos="0  0.10 0" size="0.015 0.12 0.04"
            rgba="0.95 0.45 0.10 0.65" contype="1" conaffinity="1" solref=".005 1" friction="0.05 0.005 0.0001"/>
      <geom name="gate2_bottom" type="box" pos="0 -0.28 0" size="0.015 0.10 0.04"
            rgba="0.95 0.45 0.10 0.65" contype="1" conaffinity="1" solref=".005 1" friction="0.05 0.005 0.0001"/>
    </body>


    <!-- Start / target visual markers (small spheres). -->
    <site name="start_marker"  pos="0.40 0 0.34" size="0.018" rgba="0.10 0.95 0.20 0.9"/>
    <site name="target_marker" pos="0.65 0 0.30" size="0.018" rgba="0.95 0.10 0.10 0.9"/>
  </worldbody>

  <contact>
    <exclude body1="world" body2="left_finger"/>
    <exclude body1="world" body2="right_finger"/>
    <exclude body1="left_finger" body2="right_finger"/>

    <!-- Explicit gate-wall / robot pairs (named FR3 collision geoms). -->
    <pair geom1="gate1_top"    geom2="fr3_link0_collision"/>
    <pair geom1="gate1_top"    geom2="fr3_link1_collision"/>
    <pair geom1="gate1_top"    geom2="fr3_link2_collision"/>
    <pair geom1="gate1_top"    geom2="fr3_link3_collision"/>
    <pair geom1="gate1_top"    geom2="fr3_link4_collision"/>
    <pair geom1="gate1_top"    geom2="fr3_link5_collision"/>
    <pair geom1="gate1_top"    geom2="fr3_link6_collision"/>
    <pair geom1="gate1_top"    geom2="fr3_link7_collision"/>
    <pair geom1="gate1_top"    geom2="stylus"/>
    <pair geom1="gate1_bottom" geom2="fr3_link0_collision"/>
    <pair geom1="gate1_bottom" geom2="fr3_link1_collision"/>
    <pair geom1="gate1_bottom" geom2="fr3_link2_collision"/>
    <pair geom1="gate1_bottom" geom2="fr3_link3_collision"/>
    <pair geom1="gate1_bottom" geom2="fr3_link4_collision"/>
    <pair geom1="gate1_bottom" geom2="fr3_link5_collision"/>
    <pair geom1="gate1_bottom" geom2="fr3_link6_collision"/>
    <pair geom1="gate1_bottom" geom2="fr3_link7_collision"/>
    <pair geom1="gate1_bottom" geom2="stylus"/>
    <pair geom1="gate2_top"    geom2="fr3_link0_collision"/>
    <pair geom1="gate2_top"    geom2="fr3_link1_collision"/>
    <pair geom1="gate2_top"    geom2="fr3_link2_collision"/>
    <pair geom1="gate2_top"    geom2="fr3_link3_collision"/>
    <pair geom1="gate2_top"    geom2="fr3_link4_collision"/>
    <pair geom1="gate2_top"    geom2="fr3_link5_collision"/>
    <pair geom1="gate2_top"    geom2="fr3_link6_collision"/>
    <pair geom1="gate2_top"    geom2="fr3_link7_collision"/>
    <pair geom1="gate2_top"    geom2="stylus"/>
    <pair geom1="gate2_bottom" geom2="fr3_link0_collision"/>
    <pair geom1="gate2_bottom" geom2="fr3_link1_collision"/>
    <pair geom1="gate2_bottom" geom2="fr3_link2_collision"/>
    <pair geom1="gate2_bottom" geom2="fr3_link3_collision"/>
    <pair geom1="gate2_bottom" geom2="fr3_link4_collision"/>
    <pair geom1="gate2_bottom" geom2="fr3_link5_collision"/>
    <pair geom1="gate2_bottom" geom2="fr3_link6_collision"/>
    <pair geom1="gate2_bottom" geom2="fr3_link7_collision"/>
    <pair geom1="gate2_bottom" geom2="stylus"/>
  </contact>

  <keyframe>
    <key name="home" qpos="0 -0.78539816 0 -2.35619449 0 1.57079632 0.78539816"/>
  </keyframe>

  <sensor>
    <!-- Sensor ordering matches MPPI_Force (Fr3 wipe) task exactly so the
         Residual() in fr3_maze_force.cc walks the same order. Gate1/Gate2
         are appended (maze leftover, currently disabled — residual = 0). -->
    <user name="Reach_pos"         dim="3" user="2 1000000 0 5000000  0.01"/>
    <user name="Reach_ori"         dim="3" user="2 50000   0 500000   0.01"/>
    <user name="joint_cent"        dim="7" user="2 20      0 5000     1"/>
    <user name="joint_vel_penalty" dim="7" user="2 500     0 5000     0.01"/>
    <user name="EE_Force"          dim="3" user="2 100     0 2000     1"/>
    <user name="u_reg"             dim="7" user="2 0.01    0 1        0.01"/>
    <user name="EE_zvel"           dim="1" user="2 20000   0 100000   0.01"/>
    <user name="FM_track"          dim="7" user="2 10000   0 50000    0.01"/>
    <user name="Gate1"             dim="1" user="2 10000000 0 100000000 0.01"/>
    <user name="Gate2"             dim="1" user="2 10000000 0 100000000 0.01"/>

    <!-- EE definition is the extended stylus tip (link7 frame z=0.295). -->
    <framepos  name="hand"               objtype="site" objname="stylus_tip"/>
    <framequat name="hand_orient"        objtype="site" objname="stylus_tip"/>
    <framepos  name="hand_target"        objtype="site" objname="hand_copy_site"/>
    <framequat name="hand_target_orient" objtype="site" objname="hand_copy_site"/>
    <framepos  name="trace0"             objtype="site" objname="stylus_tip"/>
  </sensor>

  <include file="fr3_yeshand.xml"/>
</mujoco>
