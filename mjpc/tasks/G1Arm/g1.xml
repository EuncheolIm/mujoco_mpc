<mujoco model="g1_29dof_rev_1_0">
  <compiler angle="radian" meshdir="../g1/assets"/>

  <!-- timestep=0.002 matches RL_g1 g1_29dof_mode_15.xml. mjpc's explicit
       motor + manual PD is much more dt-sensitive than IsaacLab's PhysX
       implicit actuator, so the training-sim dt (0.005) was driving waist PD
       into the explicit-Euler instability range. integrator=implicit adds
       extra numerical damping for stiff joints. -->
  <option timestep="0.002" integrator="implicit"/>

  <default>
    <default class="g1">
      <site rgba="1 0 0 1" size="0.01" group="5"/>
      <!-- Joint defaults match RL_g1 g1_29dof_mode_15.xml so the chattering
           profile is the same as the model the RL policy was deployed on:
             armature 0.1, damping 2.0, stiffness 0.2, frictionloss 0.1. -->
      <joint armature="0.1" damping="2.0" stiffness="0.2" frictionloss="0.1"/>
      <!-- Actuators are now plain torque motors, mirroring RL_g1's
           g1_29dof_mode_15.xml. PD impedance is computed by the controller
           (RLOnlyPlanner::ActionFromPolicy uses RL_g1 yaml gains and clamps
           to the per-joint IsaacLab effort_limit_sim values).
           ctrllimited=true is required by mjpc; we set ctrlrange to ±200 Nm
           which exceeds every per-joint effort limit (max knee=139) so this
           XML-level clamp is just a safety net, not the actual limit. -->
      <motor gear="1 0 0 0 0 0" ctrllimited="true" ctrlrange="-200 200"/>
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0" density="0" material="metal"/>
      </default>
      <default class="collision">
        <geom group="3" type="mesh"/>
        <default class="foot">
          <geom type="sphere" size="0.005" priority="1" friction="0.6" condim="3"/>
        </default>
      </default>
    </default>
  </default>

